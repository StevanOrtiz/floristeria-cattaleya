---
interface Props { light?: boolean }
const { light = false } = Astro.props;
---
<span class:list={['logo', { light }]}>
  <svg class="mark" viewBox="0 0 64 64" width="52" height="52" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
    <path d="M32 30C22 22 22 8 32 5c10 3 10 17 0 25Z"/>
    <path d="M32 33C20 36 8 30 7 20c9-4 20 0 25 13Z"/>
    <path d="M32 33c12 3 24-3 25-13-9-4-20 0-25 13Z"/>
    <path d="M32 36c-9 8-8 20 0 24 8-4 9-16 0-24Z"/>
    <circle cx="32" cy="32" r="3"/>
  </svg>
  <span class="txt">
    <span class="top">FLORISTERÍA</span>
    <span class="script name">Cattaleya</span>
    <span class="bot">FLORES · PLANTAS · DETALLES</span>
  </span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: .6rem; color: var(--orchid); text-decoration: none; line-height: 1; }
  .logo.light { color: #fff; }
  .txt { display: grid; gap: .1rem; }
  .top { font: 500 .72rem var(--sans); letter-spacing: .3em; padding-left: 1.6rem; color: var(--wine); }
  .light .top { color: #fff; }
  .name { font-size: 2.6rem; line-height: .95; }
  .bot { font: .5rem var(--sans); letter-spacing: .22em; color: var(--wine); padding-left: .2rem; }
  .light .bot { color: #ffffffcc; }
  @media (max-width: 640px) { .name { font-size: 2rem; } .mark { width: 40px; height: 40px; } }
</style>

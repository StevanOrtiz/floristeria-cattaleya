---
import { business } from '../lib/site';
---
<div class="map" data-map data-src={business.mapsEmbed}>
  <div class="ph">
    <p>El mapa usa Google Maps. Acepta las cookies de terceros para verlo.</p>
    <button type="button" class="btn btn-sm btn-outline" data-consent-open>Configurar cookies</button>
  </div>
  <a class="how" href={business.mapsLink} target="_blank" rel="noopener">Cómo llegar →</a>
</div>

<style>
  .map { position: relative; border-radius: 10px; overflow: hidden; background: #e8eef0; min-height: 150px; height: 100%; }
  .map :global(iframe) { width: 100%; height: 100%; min-height: 150px; border: 0; display: block; }
  .ph { display: grid; place-items: center; gap: .5rem; text-align: center; padding: 1rem; height: 100%; min-height: 150px; color: var(--ink); font-size: .8rem; }
  .ph p { margin: 0; }
  .how { position: absolute; right: 8px; bottom: 8px; background: #fff; color: var(--forest); padding: .35rem .9rem; border-radius: 999px; font-size: .8rem; text-decoration: none; box-shadow: 0 2px 8px rgb(0 0 0 / .2); }
</style>

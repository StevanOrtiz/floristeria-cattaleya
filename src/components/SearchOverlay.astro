---
import Icon from './Icon.astro';
---
<div id="search-overlay" class="so" role="dialog" aria-modal="true" aria-label="Buscar productos" hidden>
  <div class="panel">
    <form action="/buscar" method="get" role="search" class="field">
      <Icon name="search" size={20} />
      <input id="search-input" name="q" type="text" autocomplete="off" placeholder="Busca rosas, lilium, cumpleaños…"
        role="combobox" aria-expanded="false" aria-controls="search-results" aria-autocomplete="list" maxlength="80" />
      <button type="button" class="x" data-search-close aria-label="Cerrar búsqueda"><Icon name="close" size={20} /></button>
    </form>
    <ul id="search-results" role="listbox" aria-label="Sugerencias"></ul>
    <p id="search-empty" class="empty" hidden>Sin resultados. Prueba con otra palabra o escríbenos por WhatsApp.</p>
  </div>
</div>

<style>
  .so { position: fixed; inset: 0; z-index: 120; background: rgb(58 42 49 / .55); display: grid; align-items: start; justify-items: center; padding: 8vh 12px 0; }
  .so[hidden] { display: none; }
  .panel { width: min(640px, 100%); background: var(--cream); border-radius: 18px; padding: 1rem; box-shadow: 0 20px 60px rgb(0 0 0 / .3); }
  .field { display: flex; align-items: center; gap: .6rem; border: 1.5px solid var(--line); border-radius: 12px; padding: .5rem .8rem; background: #fff; }
  .field input { flex: 1; border: 0; outline: 0; font: 1rem var(--sans); background: none; }
  .x { background: none; border: 0; cursor: pointer; color: var(--wine); display: grid; }
  ul { list-style: none; margin: .6rem 0 0; padding: 0; display: grid; gap: .25rem; max-height: 55vh; overflow: auto; }
  ul :global(a) { display: flex; gap: .8rem; align-items: center; padding: .5rem; border-radius: 10px; text-decoration: none; }
  ul :global(a:hover), ul :global(a[aria-selected='true']) { background: var(--blush); }
  ul :global(img) { width: 52px; height: 52px; object-fit: cover; border-radius: 8px; background: var(--blush-2); }
  ul :global(.t) { display: grid; line-height: 1.3; }
  ul :global(.t small) { color: var(--muted); }
  ul :global(.pr) { margin-left: auto; font-weight: 600; white-space: nowrap; }
  .empty { margin: .8rem .4rem 0; color: var(--muted); }
</style>

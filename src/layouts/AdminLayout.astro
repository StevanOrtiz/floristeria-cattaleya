---
import Base from './Base.astro';
interface Props { title: string; showNav?: boolean }
const { title, showNav = true } = Astro.props;
---
<Base title={`${title} · Admin`} noindex bare>
  <div class="adm" data-csrf={Astro.locals.csrf ?? ''}>
    {showNav && (
      <header class="top">
        <a href="/admin" class="t">Cattaleya · Admin</a>
        <nav>
          <a href="/" target="_blank" rel="noopener">Ver web</a>
          <button type="button" data-logout>Salir</button>
        </nav>
      </header>
    )}
    <div class="body"><slot /></div>
  </div>
  <script>import '../scripts/admin';</script>
</Base>

<style is:global>
  .adm { min-height: 100vh; background: #f6f1f2; }
  .adm .top { display: flex; justify-content: space-between; align-items: center; padding: .8rem 1.2rem; background: var(--forest); color: #fff; }
  .adm .top a, .adm .top button { color: #fff; background: none; border: 0; font: inherit; cursor: pointer; margin-left: 1rem; text-decoration: none; }
  .adm .top .t { font: 600 1.1rem var(--serif); margin: 0; }
  .adm .body { max-width: 980px; margin: 0 auto; padding: 1.5rem 1rem 4rem; }
  .adm h1 { font-size: 1.8rem; }
  .adm .panel { background: #fff; border-radius: 14px; padding: 1.2rem; box-shadow: 0 2px 10px rgb(74 38 56 / .06); margin-bottom: 1.2rem; }
  .adm table { width: 100%; border-collapse: collapse; font-size: .9rem; }
  .adm th, .adm td { text-align: left; padding: .6rem .5rem; border-bottom: 1px solid var(--line); vertical-align: middle; }
  .adm td img { width: 44px; height: 44px; object-fit: cover; border-radius: 6px; }
  .adm .badge { font-size: .72rem; padding: .1rem .5rem; border-radius: 999px; background: var(--blush); color: var(--wine); }
  .adm .badge.off { background: #eee; color: #777; }
  .adm .toolbar { display: flex; flex-wrap: wrap; gap: .6rem; margin-bottom: 1rem; align-items: center; }
  .adm .toolbar input, .adm .toolbar select { padding: .55rem .8rem; border: 1px solid var(--line); border-radius: 10px; font: inherit; }
  .adm .toolbar .grow { flex: 1 1 200px; }
  .adm .danger { color: #a62323; border-color: #a62323; }
  .adm .imgs { list-style: none; padding: 0; margin: 0; display: grid; gap: .8rem; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); }
  .adm .imgs li { border: 1px solid var(--line); border-radius: 10px; padding: .5rem; display: grid; gap: .4rem; }
  .adm .imgs img { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 6px; }
  .adm .imgs input { width: 100%; padding: .3rem .5rem; font-size: .8rem; border: 1px solid var(--line); border-radius: 6px; }
  .adm .imgs .row { display: flex; gap: .3rem; }
  .adm .imgs .row button { flex: 1; padding: .25rem; font-size: .8rem; cursor: pointer; border: 1px solid var(--line); background: #fff; border-radius: 6px; }
  .adm .hint { font-size: .8rem; color: var(--muted); }
  .adm .two { display: grid; gap: 1rem; }
  @media (min-width: 720px) { .adm .two { grid-template-columns: 1fr 1fr; } }
</style>

---
import Base from '../layouts/Base.astro';
export const prerender = false;
Astro.response.status = 404;
---
<Base title="Página no encontrada" noindex>
  <section class="band" style="text-align:center">
    <div class="wrap">
      <p class="script" style="font-size:2.4rem;color:var(--orchid);margin:0">Ups…</p>
      <h1>No encontramos esa página</h1>
      <p class="muted">Puede que el enlace haya cambiado. Vuelve al inicio o mira nuestro catálogo.</p>
      <p><a class="btn btn-orchid" href="/">Ir al inicio</a> <a class="btn btn-outline" href="/catalogo">Ver catálogo</a></p>
    </div>
  </section>
</Base>

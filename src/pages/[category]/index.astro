---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ProductCard from '../../components/ProductCard.astro';
import ContactForm from '../../components/ContactForm.astro';
import { getCategoryByPath, getProducts, cachePublic, productUrl, cover } from '../../lib/catalog';
import { SITE_URL } from '../../lib/site';

const category = await getCategoryByPath('/' + Astro.params.category);
if (!category) return Astro.rewrite('/404');

Astro.response.headers.set('Cache-Control', cachePublic);
const products = await getProducts({ category: category.id });
const subs = [...new Set(products.map((p) => p.subcategory).filter(Boolean))] as string[];
const ld = [
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE_URL },
      { '@type': 'ListItem', position: 2, name: category.name, item: SITE_URL + category.path },
    ],
  },
  {
    '@context': 'https://schema.org', '@type': 'ItemList',
    itemListElement: products.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: SITE_URL + productUrl(p), name: p.name })),
  },
];
const isWedding = category.id === 'bodas';
---
<Base title={category.title} description={category.description} jsonLd={ld} image={products.map(cover).find(Boolean)?.src}>
  <PageHero title={category.name} intro={category.intro} crumbs={[{ label: category.name }]} />
  <section class="band">
    <div class="wrap">
      {subs.length >= 2 && (
        <div class="chips" role="group" aria-label="Filtrar por tipo">
          <button type="button" class="chip" data-sub="" aria-pressed="true">Todo</button>
          {subs.map((s) => <button type="button" class="chip" data-sub={s} aria-pressed="false">{s}</button>)}
        </div>
      )}
      {products.length === 0
        ? <p class="muted" style="text-align:center">Pronto añadiremos productos aquí. Escríbenos y te preparamos lo que necesites.</p>
        : (
          <ul class="cards cols-4" data-stagger>
            {products.map((p, i) => <ProductCard product={p} eager={i < 3} />)}
          </ul>
        )}
    </div>
  </section>

  {isWedding && (
    <section class="band blush" aria-labelledby="quote-title">
      <div class="wrap prose">
        <h2 id="quote-title">Pide tu presupuesto</h2>
        <p class="muted">Cuéntanos cómo imaginas tu boda o evento y te enviamos una propuesta a medida.</p>
        <ContactForm kind="evento" />
      </div>
    </section>
  )}
</Base>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('[data-sub]');
  chips.forEach((chip) => chip.addEventListener('click', () => {
    chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
    document.querySelectorAll<HTMLElement>('.cards > li').forEach((li) => {
      const tag = li.dataset.sub ?? '';
      li.hidden = !!chip.dataset.sub && tag !== chip.dataset.sub;
    });
  }));
</script>

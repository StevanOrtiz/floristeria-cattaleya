---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Acceso" showNav={false}>
  <div class="panel" style="max-width:420px;margin:10vh auto 0">
    <h1>Acceso</h1>
    <form class="form" data-login>
      <label>Correo<input name="email" type="email" required autocomplete="username" maxlength="160" /></label>
      <label>Contraseña<input name="password" type="password" required autocomplete="current-password" maxlength="200" /></label>
      <div class="form-msg err" role="alert" hidden></div>
      <button class="btn btn-orchid" type="submit">Entrar</button>
    </form>
  </div>
</AdminLayout>
